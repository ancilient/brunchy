# Copy this file to .env (never commit .env). Defaults match docker-compose.yml.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=brunchy
DB_PASSWORD=brunchy
DB_NAME=brunchy

REDIS_URL=redis://127.0.0.1:6379/0

# Long random strings. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Ordering rules
HOLD_MINUTES=5
# Platform fee = this % of item total only (covers platform fee + GST; no separate stall GST).
# Payable = items + platform fee + convenience fee (each a % of the items); first N paid orders free of both
PLATFORM_FEE_PERCENT=3
CONVENIENCE_FEE_PERCENT=3
FREE_ORDERS_PER_STUDENT=2

# Payments: mock (dev fake pay) or razorpay (test/live keys from https://dashboard.razorpay.com/app/keys)
PAYMENT_GATEWAY=razorpay
MOCK_GATEWAY_SECRET=change-me-mock-webhook-secret
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# Optional until you expose /api/v1/payments/webhook publicly (ngrok / deployed API)
RAZORPAY_WEBHOOK_SECRET=

# Sign in with Google: the OAuth client ID of type "Web application" from Google Cloud Console
# (APIs & Services > Credentials). Several IDs may be listed, comma separated. Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=
# Optional: only these email domains may create student accounts, e.g. sathyabama.ac.in (empty = any Google account).
STUDENT_EMAIL_DOMAINS=

# Development helpers (must be false in production)
# DEV_LOGIN=true shows "Continue as demo student / vendor" in the apps (POST /auth/dev-login), no Google needed.
DEV_LOGIN=true
# IGNORE_CANTEEN_HOURS=true lets you place orders outside canteen opening hours while developing at night.
IGNORE_CANTEEN_HOURS=true

JOBS_ENABLED=true
RATE_LIMIT_ENABLED=true

# Customer Care in the student app and the GST number on bills (empty = hidden / placeholder)
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
GSTIN=
