# Copy this file to .env (never commit .env). Defaults match docker-compose.yml.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=brunchy
DB_PASSWORD=brunchy
DB_NAME=brunchy

REDIS_URL=redis://127.0.0.1:6379/0

# Long random strings. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Ordering rules
HOLD_MINUTES=5
CONVENIENCE_FEE=5

# Payments: only the mock gateway exists in milestone 1. Razorpay is added later behind the same interface.
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_SECRET=change-me-mock-webhook-secret

# Development helpers (must be false in production)
# OTP_DEV_ECHO=true returns the OTP in the /auth/otp response so the apps can log in without SMS.
OTP_DEV_ECHO=true
# IGNORE_CANTEEN_HOURS=true lets you place orders outside canteen opening hours while developing at night.
IGNORE_CANTEEN_HOURS=true

JOBS_ENABLED=true
RATE_LIMIT_ENABLED=true
