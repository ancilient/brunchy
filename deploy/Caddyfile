# Caddy gets and renews a free HTTPS certificate (Let's Encrypt) for API_DOMAIN automatically,
# serves food photos from deploy/uploads at /uploads/, and passes everything else (including Socket.IO
# WebSockets) to the API container.
{$API_DOMAIN} {
	encode zstd gzip

	handle_path /uploads/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		reverse_proxy api:4000
	}
}

# Admin dashboard (admin_web): the built files from deploy/admin, plus the API on the same address
# (/api and /socket.io), so the panel's sign-in cookie is first-party and no CORS is needed.
# Build and upload: see deploy/README.md, "Admin dashboard".
{$ADMIN_DOMAIN} {
	encode zstd gzip

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:4000
	}
	handle /socket.io/* {
		reverse_proxy api:4000
	}
	handle_path /uploads/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		root * /srv/admin
		# Hashed build files never change; index.html must always be fresh after a new upload.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		# The panel is a single-page app: unknown paths (e.g. /bills) load index.html.
		try_files {path} /index.html
		file_server
	}
}
