# Production settings for deploy/docker-compose.prod.yml.
# On the server:  cp .env.example .env  &&  nano .env      (deploy/.env is never committed)
# Generate each secret with:  openssl rand -hex 32

# ---- Address ----
# Free HTTPS address from the server's IP: replace dots with dashes, e.g. IP 203.0.113.10 -> api.203-0-113-10.sslip.io
# Later, with a real domain: API_DOMAIN=api.yourdomain.in (point its DNS A record at the server first).
API_DOMAIN=api.0-0-0-0.sslip.io

# ---- Database (MySQL runs in Docker; only the API can reach it) ----
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# ---- Login tokens ----
JWT_ACCESS_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# ---- Ordering rules ----
HOLD_MINUTES=5
# Payable = items + platform fee + convenience fee (each a % of the items). A student's first N paid orders are free of both.
PLATFORM_FEE_PERCENT=3
CONVENIENCE_FEE_PERCENT=3
FREE_ORDERS_PER_STUDENT=2

# ---- Student app: Customer Care and bills (empty = hidden / placeholder) ----
SUPPORT_EMAIL=
SUPPORT_PHONE=
# WhatsApp number with country code, digits only, e.g. 919876543210
SUPPORT_WHATSAPP=
GSTIN=

# ---- Payments (Razorpay). Use rzp_test_ keys until KYC is approved, then live keys. ----
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks -> URL https://<API_DOMAIN>/api/v1/payments/webhook,
# events payment.captured + payment.failed. Paste the webhook secret you set there:
RAZORPAY_WEBHOOK_SECRET=

# ---- Google sign-in (the Web client ID the apps use; same as development) ----
GOOGLE_CLIENT_IDS=
# Optional: only allow student emails from these domains (comma separated), e.g. sathyabama.ac.in
STUDENT_EMAIL_DOMAINS=

# ---- Admin panel (admin_web) ----
# The panel's web address(es), comma separated: only these may use its sign-in cookie, e.g. https://admin.brunchy.in
ADMIN_ORIGINS=
# lax when the panel and API share a site (admin.x.in + api.x.in); none when they are on different sites.
ADMIN_COOKIE_SAMESITE=lax

# ---- Must stay false in production (the API refuses to start otherwise) ----
DEV_LOGIN=false
IGNORE_CANTEEN_HOURS=false

JOBS_ENABLED=true
RATE_LIMIT_ENABLED=true
# Google sign-ins per 10 minutes: per internet address (high, a campus shares one) and per Google account.
GOOGLE_SIGNINS_PER_IP=600
GOOGLE_SIGNINS_PER_ACCOUNT=10
LOG_LEVEL=info
