# Production settings for deploy/docker-compose.prod.yml.
# On the server:  cp .env.example .env  &&  nano .env      (deploy/.env is never committed)
# Generate each secret with:  openssl rand -hex 32

# ---- Address ----
# Free HTTPS address from the server's IP: replace dots with dashes, e.g. IP 203.0.113.10 -> api.203-0-113-10.sslip.io
# Later, with a real domain: API_DOMAIN=api.yourdomain.in (point its DNS A record at the server first).
API_DOMAIN=api.0-0-0-0.sslip.io

# ---- Database (MySQL runs in Docker; only the API can reach it) ----
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# ---- Login tokens ----
JWT_ACCESS_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# ---- Ordering rules ----
HOLD_MINUTES=5
CONVENIENCE_FEE=0
PLATFORM_FEE_PERCENT=2.36

# ---- Payments (Razorpay). Use rzp_test_ keys until KYC is approved, then live keys. ----
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks -> URL https://<API_DOMAIN>/api/v1/payments/webhook,
# events payment.captured + payment.failed. Paste the webhook secret you set there:
RAZORPAY_WEBHOOK_SECRET=

# ---- Google sign-in (the Web client ID the apps use; same as development) ----
GOOGLE_CLIENT_IDS=
# Optional: only allow student emails from these domains (comma separated), e.g. sathyabama.ac.in
STUDENT_EMAIL_DOMAINS=

# ---- Must stay false in production (the API refuses to start otherwise) ----
DEV_LOGIN=false
IGNORE_CANTEEN_HOURS=false

JOBS_ENABLED=true
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
